rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if the requester is the document owner
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Helper: the requester's own user document data.
    function callerData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Plan D user-doc helpers. Identity lives at the top level, role-specific
    // data under `profiles.{role}`, admin via `isAdmin`. `.get(key, default)`
    // avoids errors when a field is absent (e.g. admin docs have no `profiles`).

    // Helper: check if the requester is an admin
    function isAdmin() {
      return isAuth() && callerData().get('isAdmin', false) == true;
    }

    // Helper: is the given user-doc data a babysitter?
    function isBabysitterData(d) {
      return d.get('profiles', {}).get('babysitter', null) != null;
    }

    // Helper: the parent familyId on a user-doc data map, or null if the user
    // is not a parent.
    function parentFamilyId(d) {
      return d.get('profiles', {}).get('parent', {}).get('familyId', null);
    }

    // Helper: the set of profile-role keys a user-doc holds (babysitter,
    // parent, tutor). Owners may edit fields WITHIN their profiles, but may
    // not add or remove a role slot — that is a privilege escalation (e.g. a
    // parent granting themselves a searchable babysitter profile).
    function profileRolesUnchanged() {
      return request.resource.data.get('profiles', {}).keys()
               .hasOnly(resource.data.get('profiles', {}).keys())
             && resource.data.get('profiles', {}).keys()
               .hasOnly(request.resource.data.get('profiles', {}).keys());
    }

    // Helper: a babysitter-profile field on a user-doc data map (safe default).
    function bsField(d, key, def) {
      return d.get('profiles', {}).get('babysitter', {}).get(key, def);
    }

    // Helper: server-owned identity fields inside profiles.babysitter that the
    // client must never mutate directly.
    // - ejemEmail: EJM identity, set by enrollBabysitter only.
    // - approvedFamilies: contact-sharing audit trail. respondToContactSharing
    //   writes auditLog entries on every change; allowing direct client writes
    //   would bypass that audit point and the GDPR-required record of which
    //   families a babysitter has shared contact with.
    function babysitterIdentityUnchanged() {
      return bsField(request.resource.data, 'ejemEmail', '')
               == bsField(resource.data, 'ejemEmail', '')
             && bsField(request.resource.data, 'approvedFamilies', [])
               == bsField(resource.data, 'approvedFamilies', []);
    }

    // Helper: a tutor-profile field on a user-doc data map (safe default).
    function tutorField(d, key, def) {
      return d.get('profiles', {}).get('tutor', {}).get(key, def);
    }

    // Helper: server-owned identity/state fields inside profiles.tutor that the
    // client must never mutate directly. The tutor state machine is server-owned:
    // - ejemEmail: EJM identity, set by enrollTutor only.
    // - enrollmentComplete: flipped false->true ONLY by reviewVerification on
    //   admin approval. (Contrast profiles.babysitter.enrollmentComplete, which
    //   is intentionally client-writable and left untouched here.)
    // - verification: identity-verification state, driven exclusively by the
    //   submitVerification / reviewVerification callables.
    // - approvedFamilies: consent audit trail. respondToTutorContactRequest is
    //   the ONLY writer (on accept); allowing direct client writes would bypass
    //   the contact-request flow and its GDPR-required record of which families
    //   the tutor has shared contact fields with. Mirrors babysitter approvedFamilies.
    // - endorsementCount: server-owned denormalized counter of approved/published
    //   endorsements, written ONLY by respondToTutorEndorsement on accept. A
    //   tutor inflating it would fake social proof and distort search ranking.
    // Defaults keep the guard trivially true for users WITHOUT a tutor profile.
    function tutorIdentityUnchanged() {
      return tutorField(request.resource.data, 'ejemEmail', '')
               == tutorField(resource.data, 'ejemEmail', '')
             && tutorField(request.resource.data, 'enrollmentComplete', false)
               == tutorField(resource.data, 'enrollmentComplete', false)
             && tutorField(request.resource.data, 'verification', {})
               == tutorField(resource.data, 'verification', {})
             && tutorField(request.resource.data, 'approvedFamilies', [])
               == tutorField(resource.data, 'approvedFamilies', [])
             && tutorField(request.resource.data, 'endorsementCount', 0)
               == tutorField(resource.data, 'endorsementCount', 0);
    }

    // Helper: the owner-editable tutor numerics must stay in enrollment's
    // validated ranges (paddingMin int 0-60; areaRadiusKm null or 0-50) —
    // client-side guards are UX only; THIS is the trust boundary. Post-state
    // check with in-range defaults, so docs without a tutor profile pass.
    function tutorNumericBoundsValid() {
      return tutorField(request.resource.data, 'paddingMin', 0) is int
             && tutorField(request.resource.data, 'paddingMin', 0) >= 0
             && tutorField(request.resource.data, 'paddingMin', 0) <= 60
             && (tutorField(request.resource.data, 'areaRadiusKm', 0) == null
                 || (tutorField(request.resource.data, 'areaRadiusKm', 0) is number
                     && tutorField(request.resource.data, 'areaRadiusKm', 0) >= 0
                     && tutorField(request.resource.data, 'areaRadiusKm', 0) <= 50))
             && (tutorField(request.resource.data, 'areaLatLng', null) == null
                 || (tutorField(request.resource.data, 'areaLatLng', null).lat is number
                     && tutorField(request.resource.data, 'areaLatLng', null).lat >= -90
                     && tutorField(request.resource.data, 'areaLatLng', null).lat <= 90
                     && tutorField(request.resource.data, 'areaLatLng', null).lng is number
                     && tutorField(request.resource.data, 'areaLatLng', null).lng >= -180
                     && tutorField(request.resource.data, 'areaLatLng', null).lng <= 180))
             // aboutMe: the account page is the only writer since enrollment
             // stopped collecting it — its 1000-char bound must live HERE,
             // not in the textarea's maxLength (rules are the trust boundary).
             && (tutorField(request.resource.data, 'aboutMe', null) == null
                 || (tutorField(request.resource.data, 'aboutMe', null) is string
                     && tutorField(request.resource.data, 'aboutMe', null).size() <= 1000));
    }

    // Helper: top-level photoUrl is owner-writable (the photo auto-save) but
    // must stay a bounded https URL — the client type/size checks are UX
    // only; without this a direct write could store a non-string, a data:
    // URI, or an arbitrary payload that search results then project.
    function photoUrlValid() {
      // UNCHANGED values always pass: legacy docs with an odd photoUrl must
      // not be locked out of every self-service edit by a stricter rule.
      // NEW values must be null or a bounded URL on our storage hosts —
      // scheme AND host constrained, so an owner cannot point their public
      // search card at a third-party beacon (or data:/javascript:).
      return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['photoUrl'])
             || request.resource.data.photoUrl == null
             || (request.resource.data.photoUrl is string
                 && request.resource.data.photoUrl.size() <= 2048
                 && (request.resource.data.photoUrl
                       .matches('https://firebasestorage[.]googleapis[.]com/.*')
                     // The storage EMULATOR serves plain-http localhost URLs.
                     || request.resource.data.photoUrl
                          .matches('http://(localhost|127[.]0[.]0[.]1)[:/].*')));
    }

    // Helper: profiles.parent.familyId is server-controlled (enrollFamily /
    // joinFamily). A client must not move themselves between families.
    function parentFamilyIdUnchanged() {
      return request.resource.data.get('profiles', {}).get('parent', {}).get('familyId', '')
               == resource.data.get('profiles', {}).get('parent', {}).get('familyId', '');
    }

    // Helper: check if the requester is a member of a family
    function isFamilyMember(familyId) {
      return isAuth() && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.parentIds;
    }

    // Helper: when identityLocked, the parent-attested identity fields
    // (firstName/lastName/dateOfBirth) are frozen client-side — corrections go
    // through the correctChildIdentity callable or admin. Trivially true for
    // unlocked accounts.
    function identityUnlockedOrUnchanged() {
      return resource.data.get('identityLocked', false) != true
             || !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['firstName', 'lastName', 'dateOfBirth']);
    }

    // Users: read own profile; parents can read active babysitters (for search results)
    match /users/{userId} {
      allow read: if isOwner(userId)
                  || isAdmin()
                  || (isAuth() && isBabysitterData(resource.data) && resource.data.status == 'active')
                  || (isAuth() && parentFamilyId(resource.data) != null
                      && parentFamilyId(resource.data) == parentFamilyId(callerData()));
      allow create, delete: if false; // Only via Cloud Functions
      // Owner-update guards (Plan D, profiles.{role} shape):
      // - Top-level identity/admin fields must never change client-side:
      //   * uid/email/status/createdAt: identity; `status` is the hard ban gate
      //     that admin's blockUser callable owns.
      //   * isAdmin: the admin-escalation vector.
      // - profileRolesUnchanged: the SET of role slots can't change — blocks a
      //   client granting itself a new role (e.g. injecting profiles.babysitter).
      // - babysitterIdentityUnchanged / tutorIdentityUnchanged /
      //   parentFamilyIdUnchanged: server-owned fields nested inside a profile
      //   the owner otherwise may edit.
      // NOTE: `profiles.babysitter.searchable` and `profiles.tutor.searchable`
      //   are intentionally editable — they are user-controlled by design
      //   (soft hide from search).
      // NOTE: `profiles.tutor.cancellationNoticeHours` is also intentionally
      //   editable — enforcement reads the per-session SNAPSHOT taken at
      //   request time (bookSession/proposeSession), so live edits cannot
      //   retro-classify existing bookings.
      // - governedBy / identityLocked: supervision mirrors owned by the
      //   guardian callables (governedBy present iff the guardianLinks doc is
      //   ACTIVE; identityLocked marks parent-attested identity).
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['uid', 'email', 'status', 'createdAt', 'isAdmin',
                                 'governedBy', 'identityLocked'])
                    && profileRolesUnchanged()
                    && babysitterIdentityUnchanged()
                    && tutorIdentityUnchanged()
                    && parentFamilyIdUnchanged()
                    && identityUnlockedOrUnchanged()
                    && tutorNumericBoundsValid()
                    && photoUrlValid();
    }

    // Families: readable + editable by family members + admin
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId) || isAdmin();
      allow create, delete: if false;
      // Field-level guard: family members can only edit profile fields from the
      // client. Sensitive state (verification.*, parentIds, preferredBabysitters,
      // searchDefaults, status) is mutated exclusively by callables via the
      // Admin SDK (which bypasses these rules).
      allow update: if isFamilyMember(familyId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['familyName', 'address', 'latLng', 'pets', 'note', 'photoUrl', 'updatedAt']);

      match /kids/{kidId} {
        allow read: if isFamilyMember(familyId) || isAdmin();
        allow write: if isFamilyMember(familyId);
      }
    }

    // Schedules: own schedule readable + writable by owner
    match /schedules/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      match /overrides/{date} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // Searches: readable by family members who created them
    match /searches/{searchId} {
      allow read: if isAuth() && isFamilyMember(resource.data.familyId);
      allow write: if false;
    }

    // Appointments: readable by involved babysitter or family
    match /appointments/{appointmentId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.babysitterUserId
        || isFamilyMember(resource.data.familyId)
        || isAdmin()
      );
      allow write: if false;
    }

    // References: read restricted to publicly-visible statuses, involved
    // parties, or admin (Hardening PR H2). Before H2 `allow read: if isAuth()`
    // let any authenticated user harvest PRIVATE/REMOVED endorsements
    // (referenceText, submittedByName, submittedByFamilyId; sit and study).
    // Disjuncts, each provable from a client query's constraints:
    //   - public status: approved/published are profile-visible to everyone;
    //   - recipient: babysitterUserId (sit) or tutorUserId (study) == caller;
    //   - submitter: submittedByUserId == caller;
    //   - submitting family: caller is a member of submittedByFamilyId;
    //   - admin.
    // .get(...) defaults keep the mixed sit/study shapes from erroring (sit
    // manual docs have no tutorUserId/submittedByUserId/submittedByFamilyId;
    // study docs have no babysitterUserId). The family disjunct is guarded by a
    // non-empty check so isFamilyMember() — which get()s the family doc — is
    // only evaluated for docs that actually carry a submittedByFamilyId; a
    // missing family would otherwise error the whole || chain and deny reads a
    // LATER disjunct (isAdmin) should grant. See the H2 rules tests.
    match /references/{referenceId} {
      allow read: if isAuth() && (
        resource.data.status in ['approved', 'published']
        || resource.data.get('babysitterUserId', '') == request.auth.uid
        || resource.data.get('tutorUserId', '') == request.auth.uid
        || resource.data.get('submittedByUserId', '') == request.auth.uid
        || (resource.data.get('submittedByFamilyId', '') != ''
            && isFamilyMember(resource.data.get('submittedByFamilyId', '')))
        || isAdmin()
      );
      // Create: babysitters may record their own offline manual references.
      // Parent endorsements (type='family_submitted') and admin/peer
      // approvals (type='manual' moving to status='approved'/'published')
      // are NOT writable from the client SDK — they go through the
      // submitFamilyEndorsement / acceptFamilyEndorsement /
      // publishManualReference callables, which validate the
      // submitter<->babysitter relationship and admin role server-side.
      // See agent-9-security-baseline.md §7 [BL-5] and [BL-6].
      allow create: if isAuth()
        && request.resource.data.status == 'private'
        && request.resource.data.babysitterUserId == request.auth.uid
        && request.resource.data.type == 'manual'
        && (!('submittedByUserId' in request.resource.data)
            || request.resource.data.submittedByUserId == null);
      // Update: owner (babysitter or submitter) may edit their own reference,
      // but cannot:
      //  - mutate the identity tuple (babysitterUserId, submittedByUserId,
      //    type, createdAt, and — for study endorsements reusing this
      //    collection — tutorUserId, appSource, submittedByFamilyId) — prevents
      //    transferring an endorsement between babysitters/tutors or families,
      //    relabeling its app, or laundering an identity post-create;
      //  - promote status to 'approved' or 'published' — kills the
      //    BLOCK-LATER-4 reference-count inflation vector via update path.
      //    Status may only transition to 'private' or 'removed' from the
      //    client. The babysitter's previous "publish my own manual reference"
      //    flow was the fraud vector itself; restoring controlled publish
      //    requires a callable with admin/peer-approval gating.
      // SUBMITTER content freeze: a parent submitter may edit their endorsement
      // ONLY while it is still 'private'. Once the recipient accepts (status
      // 'approved'/'published') the text becomes profile-visible, so it is
      // frozen — otherwise "approve-innocuous-then-edit" would defeat consent.
      // The babysitter-owner branch is intentionally unconstrained here (they
      // manage their own manual references through the existing flows).
      allow update: if isAuth()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['babysitterUserId', 'submittedByUserId', 'type', 'createdAt',
                      'tutorUserId', 'appSource', 'submittedByFamilyId'])
        && (
          resource.data.babysitterUserId == request.auth.uid
          || (
            'submittedByUserId' in resource.data
            && resource.data.submittedByUserId != null
            && resource.data.submittedByUserId == request.auth.uid
            && resource.data.status == 'private'
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status in ['private', 'removed']
        );
      allow delete: if false;
    }

    // Notifications: own only, can mark as read
    match /notifications/{notifId} {
      allow read: if isAuth() && request.auth.uid == resource.data.recipientUserId;
      allow update: if isAuth()
                    && request.auth.uid == resource.data.recipientUserId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // Invite links: no client access (validated via validateInviteLink Cloud Function)
    match /inviteLinks/{token} {
      allow read, write: if false;
    }

    // Verification codes: no client access
    match /verificationCodes/{email} {
      allow read, write: if false;
    }

    // Holidays: readable by anyone authenticated
    match /holidays/{schoolYear} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Audit log: admin only
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Kid invites: parent-created invitations for kids without an account.
    // Readable only by the creating family + admin; the kid redeems via a
    // hashed-token callable (redeemKidInvite), never a doc read — the doc
    // stores only the sha256 of the emailed token. All writes callable-only.
    match /kidInvites/{inviteId} {
      allow read: if isFamilyMember(resource.data.familyId) || isAdmin();
      allow write: if false;
    }

    // Guardian links: one supervising family per child (doc id = child uid).
    // The doc is the GDPR consent record. Readable by the child, the
    // supervising family, and admin; the whole lifecycle (pending/active/
    // revoked) is driven exclusively by the guardian callables.
    match /guardianLinks/{childUid} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.childUid
        || isFamilyMember(resource.data.familyId)
        || isAdmin()
      );
      allow write: if false;
    }

    // Cross-app session handoff codes: one-time sha256-hashed switch tokens.
    // NOBODY — not even admin — reads or writes these from clients; the
    // mint/redeem callables (Admin SDK) are the only path to them.
    match /appHandoffCodes/{codeId} {
      allow read, write: if false;
    }

    // Admin alerts (e.g. conflicting supervision claims): admin-only reads.
    // Written exclusively by callables — never by clients, even admins, so
    // every alert provably originates from a server-observed event.
    match /adminAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Enrollment exemptions: admin-managed waivers for the DOB/grad-year
    // consistency check (never the under-15 floor). Doc id = lowercased EJM
    // email. Written only by admin callables.
    match /enrollmentExemptions/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contact sharing requests: babysitter can read own, family members can read for their family
    match /contactSharingRequests/{requestId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.babysitterUserId
        || isFamilyMember(resource.data.familyId)
        || isAdmin()
      );
      allow create, update, delete: if false; // Only via Cloud Functions
    }

    // Study contact requests: the involved tutor can read own, family members
    // can read for their family. Writes go exclusively through the
    // sendTutorContactRequest / respondToTutorContactRequest callables (Admin
    // SDK), which own the consent state machine and its approvedFamilies unlock.
    match /studyContactRequests/{requestId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.tutorUserId
        || isFamilyMember(resource.data.familyId)
        || isAdmin()
      );
      allow create, update, delete: if false; // Only via Cloud Functions
    }

    // Study sessions: booking docs written exclusively by the bookSession /
    // respondToSession callables (Admin SDK), which own the pending→confirmed
    // state machine and its transactional override claim. Readable by the
    // involved tutor, the booking family's members, or an admin.
    match /study-sessions/{sessionId} {
      allow read: if isAuth() && (
        request.auth.uid == resource.data.tutorUserId
        || isFamilyMember(resource.data.familyId)
        || isAdmin()
      );
      allow create, update, delete: if false; // Only via Cloud Functions

      // Concrete occurrences of a recurring series, written exclusively by the
      // respondToSession / extendRecurring callables (Admin SDK). Read via the
      // instance's OWN denormalized tutorUserId/familyId — no parent get()
      // needed (provable from the doc itself). NO collection-group read rule in
      // v1: clients read instances per-series through this nested path, and the
      // callables' collectionGroup('instances') queries use the Admin SDK, which
      // bypasses rules. Client writes are always denied.
      match /instances/{instanceId} {
        allow read: if isAuth() && (
          request.auth.uid == resource.data.tutorUserId
          || isFamilyMember(resource.data.familyId)
          || isAdmin()
        );
        allow create, update, delete: if false; // Only via Cloud Functions
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
