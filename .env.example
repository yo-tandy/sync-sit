# Firebase Web App Configuration
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web-push VAPID public key (public by design; pairs with the FCM key pair in
# the Firebase console). Load-bearing for push in BOTH web apps.
VITE_FIREBASE_VAPID_KEY=

# ── Emulator endpoint (DEV BUILDS ONLY) ──────────────────────────────────────
# All three web apps (apps/web, apps/study-web, apps/do-web) connect to the
# Firebase emulators under `import.meta.env.DEV`. Leave every var below unset
# and they use lane 1 — localhost 9099/8080/5001/9199 — which is what
# `pnpm emulators` + `pnpm dev` have always done. Production builds never read
# these at all.
#
# Set them to point a dev server at a DIFFERENT emulator lane, so a
# browser-driven e2e run does not have to commandeer the shared dev stack
# (issue #358). See docs/emulator-lanes.md.
#
# VITE_EMULATOR_LANE=3            # 1..6; shifts all four ports by (lane-1)*10000,
#                                 # matching firebase.lane{2,3,4}.json
# VITE_EMULATOR_HOST=localhost    # host for all four emulators
# VITE_EMULATOR_AUTH_PORT=9099        # overrides the lane-derived port
# VITE_EMULATOR_FIRESTORE_PORT=8080
# VITE_EMULATOR_FUNCTIONS_PORT=5001
# VITE_EMULATOR_STORAGE_PORT=9199
#
# A malformed value throws at startup rather than quietly falling back to
# lane 1 (a silent fallback would mean the run writes to the shared dev stack).
#
# The SEED scripts take the same dial, but under plain (non-VITE_) names and on
# the COMMAND LINE rather than in this file: `LANE=3 pnpm seed:admin`, or the
# `EMULATOR_LANE` / `EMULATOR_HOST` / `EMULATOR_<SERVICE>_PORT` spellings. Same
# resolver, same lane offsets, same loud failure (issue #376).

# Cloud Functions (set via firebase functions:config or .env in functions dir)
# ALLOWED_ORIGIN=https://your-app-domain.web.app

# Email Service (Resend) — set in Cloud Functions environment
# RESEND_API_KEY=re_xxxxxxxx
