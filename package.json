{
  "name": "ejm-babysitter-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:study": "pnpm --filter study-web dev",
    "dev:do": "pnpm --filter do-web dev",
    "build": "pnpm --filter web build",
    "build:study": "pnpm --filter study-web build",
    "build:do": "pnpm --filter do-web build",
    "build:functions": "pnpm --filter functions build",
    "build:study-functions": "pnpm --filter study-functions build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "docs:links": "node scripts/check-markdown-links.mjs",
    "test": "vitest run",
    "test:unit": "pnpm -r --filter '!@ejm/tests' test && vitest run --project scripts",
    "test:integration": "ADMIN_CONFIG_TTL_MS=0 pnpm --filter @ejm/tests test",
    "test:integration:lane2": "ADMIN_CONFIG_TTL_MS=0 TEST_FIRESTORE_PORT=18080 TEST_AUTH_PORT=19099 TEST_FUNCTIONS_PORT=15001 TEST_STORAGE_PORT=19199 firebase emulators:exec --config firebase.lane2.json --only auth,functions,firestore,storage --project demo-test 'pnpm test:integration'",
    "test:integration:lane3": "ADMIN_CONFIG_TTL_MS=0 TEST_FIRESTORE_PORT=28080 TEST_AUTH_PORT=29099 TEST_FUNCTIONS_PORT=25001 TEST_STORAGE_PORT=29199 firebase emulators:exec --config firebase.lane3.json --only auth,functions,firestore,storage --project demo-test 'pnpm test:integration'",
    "test:integration:lane4": "ADMIN_CONFIG_TTL_MS=0 TEST_FIRESTORE_PORT=38080 TEST_AUTH_PORT=39099 TEST_FUNCTIONS_PORT=35001 TEST_STORAGE_PORT=39199 firebase emulators:exec --config firebase.lane4.json --only auth,functions,firestore,storage --project demo-test 'pnpm test:integration'",
    "seed:admin": "pnpm --filter @ejm/shared-core build && node apps/functions/seed-admin.cjs",
    "seed:admin:lane2": "EMULATOR_LANE=2 pnpm seed:admin",
    "seed:admin:lane3": "EMULATOR_LANE=3 pnpm seed:admin",
    "seed:admin:lane4": "EMULATOR_LANE=4 pnpm seed:admin",
    "seed:test-data": "pnpm --filter @ejm/shared-core build && node apps/functions/seed-test-data.cjs",
    "seed:test-data:lane2": "EMULATOR_LANE=2 pnpm seed:test-data",
    "seed:test-data:lane3": "EMULATOR_LANE=3 pnpm seed:test-data",
    "seed:test-data:lane4": "EMULATOR_LANE=4 pnpm seed:test-data",
    "backfill:endorsement-counts": "node apps/study-functions/backfill-endorsement-counts.cjs",
    "backfill:279-orphan-pointers": "node scripts/backfill-279-orphan-pointers.cjs",
    "backfill:family-postcode": "node scripts/backfill-family-postcode.cjs",
    "backfill:shared-identity": "node scripts/backfill-shared-identity.cjs",
    "emulators": "firebase emulators:start --only auth,functions,firestore,storage --project demo-test",
    "deploy": "firebase deploy",
    "audit:354-forged-endorsements": "node scripts/audit-354-forged-tutor-endorsements.cjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "firebase-tools": "^15.23.0",
    "playwright": "^1.60.0",
    "vitest": "^4.1.4",
    "yaml": "^2.9.0"
  }
}
