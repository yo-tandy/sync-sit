{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "vitest.setup.ts",
    // Not a test file itself -- but a global ambient declaration (no
    // import/export of its own) is only picked up by tsc when it's part of
    // the program's root file set. The main tsconfig.json gets it for free
    // via its broad `include: ["src"]`; this narrower test config needs it
    // listed explicitly, or every test reaching brandMarks.ts (transitively,
    // via UnifiedLandingPage/AppSwitchBar) fails to resolve the *.png
    // imports it declares.
    "src/assets.d.ts"
  ],
  "exclude": ["node_modules"]
}
