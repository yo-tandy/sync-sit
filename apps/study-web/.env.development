# Local dev against the Firebase emulators — `pnpm --filter study-web dev`.
#
# Vite loads this file ONLY in development mode (the `vite` dev server). Production
# builds (`vite build`, mode=production) and CI — which passes explicit VITE_* env
# — are unaffected. These are the demo-test emulator project values: non-secret
# placeholders, safe to commit, so local dev needs zero inline env vars.
VITE_FIREBASE_PROJECT_ID=demo-test
VITE_FIREBASE_STORAGE_BUCKET=demo-test.appspot.com

# The sibling sync-sit app's local dev server (apps/web vite.config.ts).
VITE_SIT_APP_URL=http://localhost:5173
