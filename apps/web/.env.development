# Local dev — `pnpm --filter web dev`.
#
# Vite loads this file ONLY in development mode (the `vite` dev server).
# Production builds (vite build, mode=production) are unaffected and fall back
# to the deployed origins. Non-secret, safe to commit.
#
# The sibling sync-study app's local dev server (apps/study-web vite.config.ts).
VITE_STUDY_APP_URL=http://localhost:5174

# Same demo-test emulator project as apps/study-web/.env.development — the two
# dev apps must share a project id or cross-app flows (handoff callables,
# shared Firestore) split across emulator namespaces.
VITE_FIREBASE_PROJECT_ID=demo-test
VITE_FIREBASE_STORAGE_BUCKET=demo-test.appspot.com
