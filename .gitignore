# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.output/

# Firebase
.firebase/
apps/functions/shared-bundle/

# Environment
.env
.env.*
# ...but example files carry placeholders, never values, and an operator
# setting up a new environment needs them IN the repo. Without this the
# staging runbook points at a file that only exists on the machine that
# wrote it (PR #374 round 2).
!.env.example
!.env.*.example
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Testing
coverage/

# Flutter
apps/mobile/.dart_tool/
apps/mobile/.packages
apps/mobile/build/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/pubspec.lock

# Firebase emulator data
firebase-debug.log
firestore-debug.log
ui-debug.log

# Local tooling (Claude Code, agent worktrees, per-machine settings)
.agents/
.claude/settings.json
.claude/skills/
.claude/worktrees/
_worktrees/

# Playwright artifacts
/test-results/
/playwright-report/
/playwright/.cache/

# Scratch file planted by scripts/__tests__/bundle-shared-for-deploy.test.ts
# (its `probeStem` constant) to prove the filter drops a stray test file
# outside __tests__. Its cleanup runs in a `finally`, so an interrupted run can
# leave it behind; ignored so it cannot be swept into a commit. That test
# asserts this line still matches, so the two cannot drift apart.
packages/*/src/__leftover_bundlerStrayProbe.test.ts

# Planted by scripts/__tests__/markdown-links.test.ts: a doc with a deliberately
# dead anchor, used to prove that repo link rot does NOT fail the `scripts` test
# project and therefore cannot block a tagged release. Its cleanup runs in a
# `finally`, so an interrupted run can leave it behind; ignored so it cannot be
# swept into a commit. That test asserts this line still matches, so the two
# cannot drift apart.
docs/__linkcheck_releaseCouplingProbe.md
