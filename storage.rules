rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // CURRENTLY UNUSED — callerData() and canWriteFamilyDocs() below have no
    // caller while the issue #153 membership check is lifted (see the
    // verification-documents block). Kept, not deleted: this cross-service
    // lookup is the thing that breaks in production, and keeping the helpers
    // makes restoring the check a one-line change once the signed-URL callable
    // lands. Do NOT wire either back into a rule without first confirming
    // cross-service calls actually work in prod — an emulator pass does not
    // prove that (the emulator serves these lookups unconditionally).

    // Helper: the requester's user document (cross-service Firestore lookup).
    // Mirrors firestore.rules callerData(); .get(key, default) avoids errors
    // when a field is absent (e.g. admin docs have no `profiles`). If the doc
    // does not exist the lookup errors, which evaluates as deny.
    function callerData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: may the holder of user-doc data `d` write into family `familyId`'s
    // verification path? Takes the data map as an argument (firestore.rules
    // idiom — parentFamilyId(d), bsField(d, ...)) so callerData() is invoked
    // exactly once per evaluation: cross-service lookups are billed as
    // Firestore reads, and we don't rely on the engine deduping them.
    // The isAdmin disjunct is intentional break-glass parity with the
    // isAdmin() disjuncts throughout firestore.rules — no live client flow
    // has admins uploading here (the admin UI only reads, via the
    // getVerificationDocument callable).
    function canWriteFamilyDocs(d, familyId) {
      return d.get('isAdmin', false) == true
             || d.get('profiles', {}).get('parent', {}).get('familyId', null) == familyId;
    }

    // Helper: is this contentType a browser-renderable/scriptable document?
    // Narrow DENYLIST (issue #281), deliberately not an allowlist: browsers
    // report File.type inconsistently (empty or application/octet-stream for
    // valid PDFs on some OS/browser combos), so an allowlist would reject
    // legitimate uploads. The denied types are the ones a browser renders as
    // a live document — with script — on storage.googleapis.com: text/html
    // directly, and XML documents (text/xml, application/xml, and ANY *+xml
    // type — xhtml+xml and svg+xml script directly; the rest via an
    // <?xml-stylesheet?> XSLT that can emit arbitrary HTML, and Firefox
    // treats every *+xml media type as an XML document). The +xml suffix
    // match dominates enumerating them. No legitimate verification flow
    // produces any of these — phones/scanners emit JPEG/PNG/PDF
    // (accept="image/*" admits SVG only incidentally) — so the breadth
    // costs nothing.
    // A raw-SDK caller controls the string byte-for-byte and browsers honor
    // 'Text/HTML', 'text/html; charset=x' and leading-whitespace spellings,
    // so: lower().trim() + prefix match, and (?s) so an embedded newline
    // ('text/html\nx') cannot escape RE2's non-newline-matching '.'.
    // The null guard keeps type-less uploads working (GCS serves those as
    // octet-stream, which downloads rather than renders).
    function isRenderableDocType(t) {
      return t != null
             && t.lower().trim()
                 .matches('(?s)(text/html|text/xml|application/xml|.*\\+xml).*');
    }

    // Verification documents — size- and type-bounded writes by any signed-in
    // caller. Size is capped at the 10MB both web clients already enforce.
    // Content type: narrow denylist only — see isRenderableDocType above
    // (defense-in-depth behind the read side's responseDisposition:
    // 'attachment', issue #281).
    // Deletes fall through to the implicit deny below — no client deletes
    // these; server-side cleanup uses the Admin SDK, which bypasses rules.
    // Reads go through getVerificationDocument cloud function (checks family ownership)
    //
    // TEMPORARY — the issue #153 family-membership check is REMOVED here.
    //
    // It read `canWriteFamilyDocs(callerData(), familyId)`, where callerData()
    // is a cross-service `firestore.get()` into users/{uid}. That call fails in
    // PRODUCTION and, because rules fail closed on an errored call, it denied
    // EVERY parent's upload with a 403 — not just some.
    //
    // Timeline: the check lived in this file for a while but only reached prod
    // in the 2026-08-28 storage-rules deploy (the first since 2026-07-07 —
    // ruleset 07885e12, the first deployed storage ruleset containing
    // firestore.get). Last successful upload: 2026-08-23. Every attempt after
    // 2026-08-28 fails.
    //
    // Ruled out: rules drift (deployed ruleset == git, byte-for-byte), user
    // data (all 40 prod parents have a valid profiles.parent.familyId matching
    // their family's parentIds), the caller's token, file size, contentType,
    // App Check (not configured), Firestore database id ((default)), and
    // bucket/Firestore region (both europe-west1). Granting the Rules service
    // agent roles/firebaserules.firestoreServiceAgent and re-releasing the
    // rules did NOT fix it. Discriminating test: profile-photos writes (no
    // cross-service call) succeed from the same session that 403s here.
    //
    // This restores the exact rule that shipped 2026-04-02 → 2026-08-28.
    // Residual risk: an authenticated caller who knows a familyId can WRITE
    // into that family's verification folder. Reads stay denied here (admin/
    // owner only, via the getVerificationDocument callable), so this is an
    // integrity risk (planting a document for admin review), not a disclosure
    // one.
    //
    // The real fix, tracked in the follow-up issue: move the membership check
    // server-side into a signed-upload-URL callable (the getVerificationDocument
    // pattern in reverse), then set this back to `allow write: if false` —
    // signed URLs bypass rules, so no cross-service call is needed at all.
    match /verification-documents/{familyId}/{allPaths=**} {
      allow read: if false;
      allow create, update: if request.auth != null
                   && request.resource.size <= 10 * 1024 * 1024
                   && !isRenderableDocType(request.resource.contentType);
    }

    // Profile photos — only the owner can write their own photo
    // App uploads with path: profile-photos/{uid}.{ext}
    match /profile-photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName[0:request.auth.uid.size()] == request.auth.uid;
    }

    // Family photos — authenticated users can upload/read
    match /family-photos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── sync-do task photos (plan §7.4) — the two-path pipeline ──
    //
    // Final objects: written only by the stripper (doStripTaskPhoto, Admin
    // SDK — bypasses these rules), read only via the signing callables
    // (doGetOwnPhotoUrl / doGetTaskPhotoUrl), which reproduce the §7.2
    // board audience that Storage rules cannot express (no Firestore
    // enrollment/status/family-membership checks here — the
    // getVerificationDocument precedent; §7.4 option 1). TASK-INDEPENDENT
    // prefix, keyed by uploader: at upload time no taskId exists yet, and
    // keying by uid makes ownership structural (§7.4).
    match /do-photos/{uid}/{photoId} {
      allow read, write: if false;
    }

    // Quarantine: the client's only upload path. Owner-scoped; the
    // doStripTaskPhoto storage trigger strips EXIF, republishes into
    // do-photos/{uid}/ (photoId == uploadId — the client-chosen return leg,
    // safe because both prefixes are keyed by the caller's own uid), then
    // deletes the original. Reads denied even to the owner: the wizard's
    // thumbnails render from the POST-strip object via doGetOwnPhotoUrl,
    // never from the geotagged original.
    match /do-uploads/{uid}/{uploadId} {
      allow read: if false;
      // Bounded: this block is copy-ready for PR5, so what it omits ships.
      // Without the size/type caps, ANY authenticated platform user (sit- and
      // study-only accounts included) could write unbounded objects of any
      // type, each one firing the stripper trigger (round 9). The
      // contentType check is client-asserted metadata, not proof of image
      // bytes — the stripper fails closed on non-image bytes regardless
      // (§8). Deletes fall through to the implicit deny (request.resource
      // is null on delete): cleanup is the stripper's and the sweep's job,
      // via the Admin SDK.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
