rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper: is this contentType a browser-renderable/scriptable document?
    // Narrow DENYLIST (issue #281), deliberately not an allowlist: browsers
    // report File.type inconsistently (empty or application/octet-stream for
    // valid PDFs on some OS/browser combos), so an allowlist would reject
    // legitimate uploads. The denied types are the ones a browser renders as
    // a live document — with script — on storage.googleapis.com: text/html
    // directly, and XML documents (text/xml, application/xml, and ANY *+xml
    // type — xhtml+xml and svg+xml script directly; the rest via an
    // <?xml-stylesheet?> XSLT that can emit arbitrary HTML, and Firefox
    // treats every *+xml media type as an XML document). The +xml suffix
    // match dominates enumerating them. No legitimate verification or
    // photo-upload flow produces any of these — phones/scanners/cameras
    // emit JPEG/PNG/HEIC/PDF (accept="image/*" admits SVG only incidentally)
    // — so the breadth costs nothing.
    //
    // Reused (issue #287) on every client-writable path below that stores
    // browser-supplied bytes served back inline via getDownloadURL:
    // profile-photos, family-photos, and do-uploads, alongside the original
    // verification-documents use. Every one of those objects is fetched
    // through firebasestorage.googleapis.com, which renders text/html and
    // image/svg+xml live and inline — the same admin/user-phishing surface
    // issue #281 closed for verification documents.
    // A raw-SDK caller controls the string byte-for-byte and browsers honor
    // 'Text/HTML', 'text/html; charset=x' and leading-whitespace spellings,
    // so: lower().trim() + prefix match, and (?s) so an embedded newline
    // ('text/html\nx') cannot escape RE2's non-newline-matching '.'.
    // The null guard keeps type-less uploads working (GCS serves those as
    // octet-stream, which downloads rather than renders).
    function isRenderableDocType(t) {
      return t != null
             && t.lower().trim()
                 .matches('(?s)(text/html|text/xml|application/xml|.*\\+xml).*');
    }

    // Verification documents — writes are callable-mediated (issue #447,
    // closing out issue #446/#449).
    //
    // History: this path used to carry a family-membership check
    // (`canWriteFamilyDocs(callerData(), familyId)`) evaluated at RULE time
    // via a cross-service `firestore.get()` into users/{uid}. That call
    // failed in PRODUCTION (missing IAM grant) and, because rules fail
    // closed on an errored call, it 403'd EVERY parent's upload — not just
    // non-members' — for the entire window between the 2026-08-28 deploy
    // that first shipped it and the interim fix that lifted it (issue #446).
    // The lifted interim rule (no membership check at all, just size +
    // contentType bounds) is preserved in git history/PR #446 for reference.
    //
    // Rather than re-attempt the cross-service construct — which #449's
    // guard (tests/rules/cross-service-guard.test.ts) now fails CI on for
    // any new occurrence — the membership check moves SERVER-SIDE into
    // `createVerificationDocumentUploadUrl`
    // (packages/shared-functions/src/verification/createVerificationDocumentUploadUrl.ts),
    // the same shape `createFamilyPhotoUploadUrl` (issue #471) already
    // proved out for family-photos below: an Admin-SDK read of users/{uid}
    // (no rules involved), re-implemented contentType/extension checks (a
    // signed-URL upload authenticates as the service account and never
    // evaluates THESE rules at all), and a short-lived V4 signed PUT URL.
    // So `create, update` are unconditional denials here: there is no
    // client write path into this prefix anymore, narrow or otherwise.
    //
    // Reads stay denied here too (admin/owner only, via the unchanged
    // getVerificationDocument callable) — this path has never allowed a
    // direct client read.
    //
    // Delete has no clause here (falls through to denial, same as before
    // this change) — no client deletes these; server-side cleanup uses the
    // Admin SDK, which bypasses rules.
    match /verification-documents/{familyId}/{allPaths=**} {
      allow read: if false;
      allow create, update: if false;
    }

    // Profile photos — only the owner can write their own photo
    // App uploads with path: profile-photos/{uid}.{ext}
    //
    // Content type: narrow denylist only — see isRenderableDocType above
    // (issue #287; PR #466 confirmed this path had NO contentType
    // constraint at all before this change, and that clients may still
    // pass an empty/application/octet-stream type — the null/no-match
    // fallthrough in isRenderableDocType keeps that allowed).
    //
    // Split into create/update vs. delete (review round on PR #470),
    // mirroring verification-documents below: `allow write` covers
    // create/update/delete, and on a delete request.resource is null, so a
    // combined `write` rule referencing request.resource.contentType denies
    // EVERY delete. profile-photos has a real, currently-live delete flow —
    // apps/web family/babysitter AccountPage.tsx and apps/study-web tutor
    // AccountPage.tsx call deleteObject() on the old avatar when the user
    // removes/replaces their photo, swallowing the error
    // (`.catch(() => {})`) — so the bug would have silently orphaned a
    // readable photo (of a minor, in the tutor case) on every remove.
    match /profile-photos/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                   && fileName[0:request.auth.uid.size()] == request.auth.uid
                   && !isRenderableDocType(request.resource.contentType);
      allow delete: if request.auth != null
                   && fileName[0:request.auth.uid.size()] == request.auth.uid;
    }

    // Family photos — authenticated users can read; writes are
    // callable-mediated (issue #471).
    //
    // Write scoping — RESOLVED (issue #471, follow-up to #287). #287 found
    // that `family-photos/{familyId}.{ext}` could in principle be narrowed
    // to "caller is a member of that family", the same way profile-photos
    // is narrowed to the caller's own uid, but doing so at RULE-EVALUATION
    // TIME needs the caller's familyId available in the rule, and there is
    // no rule-local source for it: no custom claim carries familyId onto
    // the ID token, and the only remaining route — a cross-service
    // `firestore.get()` into users/{uid} — is exactly the construct that
    // took down production in #446 (fails closed on an errored call,
    // denying every parent's write, not just non-members') and that PR
    // #462's cross-service guard test (issue #449) now fails the suite on
    // for any NEW occurrence. So #287 shipped the contentType denylist only
    // and left writes open to any authenticated user, pinned as a known gap.
    //
    // This PR closes that gap WITHOUT a rule-local familyId check: writes
    // move behind `createFamilyPhotoUploadUrl` (packages/shared-functions/
    // src/family/createFamilyPhotoUploadUrl.ts), which checks membership
    // with the Admin SDK (no rules involved — reads Firestore directly,
    // mirroring the now-dead canWriteFamilyDocs helper above EXACTLY:
    // isAdmin(caller) || caller.profiles.parent.familyId === familyId),
    // validates contentType (isRenderableDocType, re-implemented in TS —
    // signed-URL uploads never evaluate THESE rules, the signed URL
    // authenticates as the service account and bypasses them entirely) and
    // the object's file extension, and returns a short-lived V4 signed PUT
    // URL. So `create, update` become unconditional denials here: there is
    // no client write path into this prefix anymore, narrow or otherwise.
    //
    // Delete is UNCHANGED (`request.auth != null`, unscoped) — deliberately
    // not moved server-side. Rationale: (1) a delete cannot plant
    // attacker-controlled content (the write path this PR closes), so its
    // residual risk is integrity/availability (an authenticated stranger
    // could delete another family's photo), not the content-injection
    // surface #287/#471 exist to close — the same risk-class distinction
    // storage.rules already draws for verification-documents above
    // ("integrity risk ... not a disclosure one"); (2) FamilySettingsPage's
    // replace-photo flow now needs a REAL delete of the previous object
    // (unlike before this PR, upload paths are `{familyId}/{uuid}.{ext}` —
    // unique per upload, not an overwrite-in-place of a deterministic
    // path — so a stale photo would otherwise orphan silently), and the
    // client-SDK delete this enables is what makes that possible without
    // new server infrastructure. Moving delete server-side too is tracked
    // as a follow-up, not required by this issue.
    match /family-photos/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if false;
      allow delete: if request.auth != null;
    }

    // ── sync-do task photos (plan §7.4) — the two-path pipeline ──
    //
    // Final objects: written only by the stripper (doStripTaskPhoto, Admin
    // SDK — bypasses these rules), read only via the signing callables
    // (doGetOwnPhotoUrl / doGetTaskPhotoUrl), which reproduce the §7.2
    // board audience that Storage rules cannot express (no Firestore
    // enrollment/status/family-membership checks here — the
    // getVerificationDocument precedent; §7.4 option 1). TASK-INDEPENDENT
    // prefix, keyed by uploader: at upload time no taskId exists yet, and
    // keying by uid makes ownership structural (§7.4).
    match /do-photos/{uid}/{photoId} {
      allow read, write: if false;
    }

    // Quarantine: the client's only upload path. Owner-scoped; the
    // doStripTaskPhoto storage trigger strips EXIF, republishes into
    // do-photos/{uid}/ (photoId == uploadId — the client-chosen return leg,
    // safe because both prefixes are keyed by the caller's own uid), then
    // deletes the original. Reads denied even to the owner: the wizard's
    // thumbnails render from the POST-strip object via doGetOwnPhotoUrl,
    // never from the geotagged original.
    match /do-uploads/{uid}/{uploadId} {
      allow read: if false;
      // Bounded: this block is copy-ready for PR5, so what it omits ships.
      // Without the size/type caps, ANY authenticated platform user (sit- and
      // study-only accounts included) could write unbounded objects of any
      // type, each one firing the stripper trigger (round 9). The
      // contentType check is client-asserted metadata, not proof of image
      // bytes — the stripper fails closed on non-image bytes regardless
      // (§8). Deletes fall through to the implicit deny (request.resource
      // is null on delete): cleanup is the stripper's and the sweep's job,
      // via the Admin SDK.
      //
      // isRenderableDocType is ALSO required here (issue #287 audit): the
      // image/.* allowlist alone does not exclude image/svg+xml — an SVG
      // is scriptable and renders live exactly like HTML (see the helper's
      // comment above), and 'image/svg+xml' matches 'image/.*' byte-for-
      // byte. The allowlist stays (it's the right shape for a
      // single-uploader-controlled prefix with no legitimate non-image use
      // — unlike profile-photos/family-photos, which admit whatever a
      // browser's File.type reports); the denylist closes the one gap in it.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && !isRenderableDocType(request.resource.contentType);
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
